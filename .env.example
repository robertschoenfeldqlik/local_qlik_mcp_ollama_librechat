#==============================================================#
#                    LibreChat + Ollama + Qlik MCP             #
#                    Environment Configuration                 #
#==============================================================#

#--------------------------------------------------------------#
#                     Qlik Cloud Settings                      #
#--------------------------------------------------------------#

# Your Qlik Cloud tenant URL (e.g., https://your-tenant.us.qlikcloud.com)
QLIK_TENANT_URL=https://your-tenant.us.qlikcloud.com

# Qlik Cloud OAuth Client ID — create a Native OAuth client in the Qlik Cloud
# Administration activity center under OAuth, with scopes: user_default, mcp:execute
# and redirect URL: http://localhost:3080/api/mcp/qlik/oauth/callback
QLIK_OAUTH_CLIENT_ID=your_oauth_client_id_here

#--------------------------------------------------------------#
#                   LibreChat Core Settings                    #
#--------------------------------------------------------------#

# Credentials encryption key (32 chars) — generate with: openssl rand -hex 16
CREDS_KEY=your_32_char_credentials_key_here

# Credentials IV (16 chars) — generate with: openssl rand -hex 8
CREDS_IV=your_16_char_iv_here

# JWT Secret — generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# JWT Refresh Secret — generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Allow new user registration (set to false to disable after creating your account)
ALLOW_REGISTRATION=true

#--------------------------------------------------------------#
#                    MongoDB Configuration                     #
#--------------------------------------------------------------#

MONGO_URI=mongodb://mongodb:27017/LibreChat

#--------------------------------------------------------------#
#                  MeiliSearch Configuration                   #
#--------------------------------------------------------------#

MEILISEARCH_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=your_meilisearch_master_key

#--------------------------------------------------------------#
#               RAG / Vector DB Configuration                  #
#--------------------------------------------------------------#

RAG_API_URL=http://rag_api:8000
VECTOR_DB_TYPE=pg
POSTGRES_DB=vectordb
POSTGRES_USER=vectordb
POSTGRES_PASSWORD=your_postgres_password_here
DB_HOST=vectordb
DB_PORT=5432
